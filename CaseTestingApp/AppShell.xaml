<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CaseTestingApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CaseTestingApp.Pages"
    Shell.FlyoutBehavior="Locked">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Stream Video Play"
        ContentTemplate="{DataTemplate pages:StreamVideoPlayPage}"
        Route="StreamVideoPlay" />
    <ShellContent
        Title="Presentation Views"
        ContentTemplate="{DataTemplate pages:ViewsPage}"
        Route="Views" />
</Shell>
